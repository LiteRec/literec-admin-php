parameters:
    phpat:
        show_rule_names: true

services:
    -
        class: App\Tests\Architecture\EverythingIsFinalRule
        tags:
            - phpat.test
    -
        class: App\Tests\Architecture\NoConcreteInheritanceRule
        tags:
            - phpat.test
    -
        class: App\Tests\Architecture\ControllersStayThinRule
        tags:
            - phpat.test
    -
        class: App\Tests\Architecture\HandlersExposeOnePublicMethodRule
        tags:
            - phpat.test
    -
        class: App\Tests\Architecture\NoSplExceptionsInDomainOrApplicationRule
        tags:
            - phpat.test
    -
        class: App\Tests\Architecture\CommandAndQueryDtoPurityRule
        tags:
            - phpat.test
    -
        class: App\Tests\Architecture\DomainEventShapeRule
        tags:
            - phpat.test
    -
        class: App\Tests\Architecture\DoctrineRepositoriesImplementDomainPortRule
        tags:
            - phpat.test
    -
        class: App\Tests\Architecture\RanksDoNotReferencePrivilegesRule
        tags:
            - phpat.test
