{# @param string title     Headline (e.g. "Coming soon", "No reports yet"). #}
{# @param string message   Supporting paragraph. #}
{# @param ?string ctaLabel Optional call-to-action label. #}
{# @param ?string ctaRoute Optional Symfony route name (rendered only if ctaLabel is also given). #}
{# @param ?string icon     Optional icon name from _icon.html.twig. Defaults to 'leaf'. #}
{% import 'components/_icon.html.twig' as ui %}
{% set title = title|default('No data') %}
{% set message = message|default('') %}
{% set ctaLabel = ctaLabel|default(null) %}
{% set ctaRoute = ctaRoute|default(null) %}
{% set icon = icon|default('leaf') %}
<div class="lr-card p-10 text-center">
    <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-litrec-surface-2 text-litrec-primary">
        {{ ui.icon(icon, 24) }}
    </div>
    <h2 class="mt-4 font-heading text-xl font-semibold text-litrec-text [font-synthesis-weight:none]">{{ title }}</h2>
    {% if message is not empty %}
        <p class="mt-2 text-sm text-litrec-text-muted">{{ message }}</p>
    {% endif %}
    {% if ctaLabel is not null and ctaRoute is not null %}
        <p class="mt-4">
            <a href="{{ path(ctaRoute) }}" class="lr-btn lr-btn-primary">
                {{ ctaLabel }}
            </a>
        </p>
    {% endif %}
</div>
