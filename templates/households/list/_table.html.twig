{# Users table partial (LRA-192). Rendered both as part of the full list page
   and as the HTMX swap target when filters, segment, or pagination change.
   Expects:
     - page:     PageOfMembers
     - criteria: SearchMembersCriteria
     - counts:   MemberSegmentCounts #}
{% import 'components/_icon.html.twig' as ui %}
{% import 'households/_residency.html.twig' as residency %}
{% set baseQuery = app.request.query.all %}

{# Live-region OOB update (LRA-153) so screen readers hear the new count on
   every HTMX swap. The matching id is rendered (without hx-swap-oob) in the
   list shell so it exists on first paint. Emit the OOB copy only on HTMX
   requests so a full page render keeps the shell span as the single live
   region (no duplicate id). #}
{% if app.request.headers.get('HX-Request') == 'true' %}
    <span
        id="members-result-summary"
        hx-swap-oob="true"
        aria-live="polite"
        class="sr-only"
    >Showing {{ page.items|length }} of {{ page.totalItems }} {{ page.totalItems == 1 ? 'user' : 'users' }}</span>

    {# Keeps the filter pill counts (and the hidden segment field they carry)
       in sync with the current q as the operator types (LRA-192 AC). #}
    {% include 'households/list/_segment_pills.html.twig' with {
        counts: counts,
        currentSegment: criteria.segment,
        oob: true,
    } %}
{% endif %}

{# Empty state fires only when the underlying result set is truly empty.
   page.items can be empty on an out-of-range page even when totalItems > 0,
   in which case the user should see the pagination footer rather than a
   misleading "no matches" panel. #}
{% if page.totalItems == 0 %}
    {% include 'components/_empty_state.html.twig' with {
        title: 'No users found',
        message: criteria.q is not null
            ? 'No users match “' ~ criteria.q ~ '”.'
            : 'No users match your filters.',
        ctaLabel: 'Clear filters',
        ctaRoute: 'users_index',
    } only %}
{% else %}
    <div class="lr-card overflow-x-auto">
        <table class="lr-table">
            <thead>
                <tr>
                    <th scope="col">User</th>
                    <th scope="col">Code</th>
                    <th scope="col">Household</th>
                    <th scope="col">Residency</th>
                    <th scope="col">Membership</th>
                    <th scope="col">Last visit</th>
                    <th scope="col">Status</th>
                    <th scope="col"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                {% for item in page.items %}
                    {% set rowHref = path('member_detail', { householdId: item.householdId, memberId: item.memberId }) %}
                    {% set tint = loop.index0 is even ? 'bg-litrec-sage-200 text-litrec-sage-800' : 'bg-litrec-accent-200 text-litrec-accent-900' %}
                    <tr data-testid="member-row-{{ item.memberId }}">
                        <td>
                            <a href="{{ rowHref }}" class="flex items-center gap-3 text-litrec-text hover:underline">
                                {% include 'households/detail/_member_avatar.html.twig' with {
                                    photoVersion: item.photoVersion,
                                    initials: item.fullName|slice(0, 1),
                                    photoRouteParams: { householdId: item.householdId, memberId: item.memberId, version: item.photoVersion },
                                    size: 'sm',
                                    initialsColorClass: tint,
                                } only %}
                                <span class="flex flex-col">
                                    <span class="font-semibold">{{ item.fullName }}</span>
                                    <span class="text-xs text-litrec-text-muted">{{ item.email ?: '—' }}</span>
                                </span>
                            </a>
                        </td>
                        <td class="whitespace-nowrap font-mono text-xs text-litrec-text-muted">
                            {{ item.memberCode }}
                        </td>
                        <td class="text-litrec-text-muted">
                            {{ item.householdName }}
                        </td>
                        <td class="whitespace-nowrap">
                            {% include 'components/_badge.html.twig' with {
                                label: residency.label(item.residencyStatus),
                                variant: residency.variant(item.residencyStatus),
                            } only %}
                        </td>
                        <td class="whitespace-nowrap text-litrec-text-muted">—</td>
                        <td class="whitespace-nowrap text-litrec-text-muted">—</td>
                        <td class="whitespace-nowrap">
                            <span class="inline-flex items-center gap-2 text-litrec-text">
                                {# --lr-success / --lr-text-muted (not the sage-500/neutral-400 ramp
                                   steps, which carry no dark-mode override) — the same dark-safe
                                   status-dot pairing the dashboard uses (templates/dashboard/index.html.twig,
                                   LRA-195). #}
                                <span
                                    aria-hidden="true"
                                    class="lr-dot"
                                    style="background: {{ item.isActive ? 'var(--lr-success)' : 'var(--lr-text-muted)' }}"
                                ></span>
                                {{ item.isActive ? 'Active' : 'Inactive' }}
                            </span>
                            {% if item.isMerged %}
                                {% include 'components/_badge.html.twig' with { label: 'Merged', variant: 'neutral', class: 'ml-1' } only %}
                            {% endif %}
                        </td>
                        <td class="whitespace-nowrap text-right">
                            <div
                                class="relative inline-block"
                                x-data="{ open: false }"
                                @keydown.escape.window="open = false"
                                @click.outside="open = false"
                            >
                                {# A disclosure, not an ARIA menu: role="menu"/"menuitem" would promise
                                   arrow-key navigation and focus-on-open that this popover does not
                                   implement (LRA-192 review). aria-expanded + aria-controls describe
                                   what it actually is; x-trap keeps Tab contained while it is open. #}
                                <button
                                    type="button"
                                    class="lr-btn lr-btn-ghost lr-btn-icon"
                                    @click="open = !open"
                                    :aria-expanded="open ? 'true' : 'false'"
                                    aria-controls="member-row-actions-{{ item.memberId }}"
                                    aria-label="More actions for {{ item.fullName }}"
                                    data-testid="member-row-menu-{{ item.memberId }}"
                                >
                                    {{ ui.icon('more', 16) }}
                                </button>
                                <div
                                    id="member-row-actions-{{ item.memberId }}"
                                    x-show="open"
                                    x-cloak
                                    x-trap="open"
                                    class="absolute right-0 top-full z-10 mt-1 min-w-[9rem] rounded-card border border-litrec-border bg-litrec-surface py-1 text-left shadow-pop"
                                >
                                    <a
                                        href="{{ rowHref }}"
                                        class="lr-btn lr-btn-ghost lr-btn-block"
                                        data-testid="member-row-view-{{ item.memberId }}"
                                    >
                                        View
                                    </a>
                                    {% if not item.isAnonymized and not item.isMerged %}
                                        <button
                                            type="button"
                                            class="lr-btn lr-btn-ghost lr-btn-block text-danger-fg"
                                            data-testid="member-row-anonymize-{{ item.memberId }}"
                                            hx-get="{{ path('member_anonymize_form', { householdId: item.householdId, memberId: item.memberId }) }}"
                                            hx-target="body"
                                            hx-swap="beforeend"
                                            aria-haspopup="dialog"
                                        >
                                            Anonymize…
                                        </button>
                                    {% endif %}
                                    {# Sell/Message have no backing feature yet (no sale-from-list
                                       or messaging flow exists) — rendered disabled rather than as
                                       dead-end tab stops, matching the header Notifications button
                                       (templates/app.html.twig). #}
                                    <button type="button" class="lr-btn lr-btn-ghost lr-btn-block" disabled aria-disabled="true">
                                        Sell
                                    </button>
                                    <button type="button" class="lr-btn lr-btn-ghost lr-btn-block" disabled aria-disabled="true">
                                        Message
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination footer. Previous/Next reuse the current query string with
       the page param overridden, so active filters survive navigation. #}
    {% set totalPages = page.totalPages() %}
    {% set prevQuery = baseQuery|merge({ page: page.page - 1 }) %}
    {% set nextQuery = baseQuery|merge({ page: page.page + 1 }) %}
    {% set rangeFrom = page.items is empty ? 0 : ((page.page - 1) * page.pageSize) + 1 %}
    {% set rangeTo = ((page.page - 1) * page.pageSize) + page.items|length %}
    {% include 'components/_table_footer.html.twig' with {
        ariaLabel: 'Users pagination',
        statusTestid: 'pagination-status',
        pageNumber: page.page,
        totalPages: totalPages > 0 ? totalPages : 1,
        statusLabel: 'Showing ' ~ rangeFrom ~ '–' ~ rangeTo ~ ' of ' ~ page.totalItems ~ ' users',
        prevTestid: 'pagination-previous',
        nextTestid: 'pagination-next',
        prevHref: page.page <= 1 ? null : path('users_index', prevQuery),
        nextHref: page.page >= totalPages ? null : path('users_index', nextQuery),
        prevHxGet: page.page <= 1 ? null : path('households_members_table', prevQuery),
        nextHxGet: page.page >= totalPages ? null : path('households_members_table', nextQuery),
        hxTarget: '#members-table',
    } only %}
{% endif %}
