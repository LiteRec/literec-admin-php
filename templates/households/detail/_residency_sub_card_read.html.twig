{# Residency sub-card — read mode (LRA-44).

   Renders the member's current residency status as a badge plus an
   "as of" effective-from date when the history table has an entry for
   the member. The wrapping #residency-sub-card-body element is the HTMX
   `outerHTML` swap target.

   Expects:
     - detail: App\Households\Application\Query\Port\MemberDetail
#}
{% import 'households/_residency.html.twig' as residency %}
<div id="residency-sub-card-body" data-testid="residency-sub-card-body" class="rounded-card-sm border border-litrec-border bg-litrec-surface p-4">
    <div class="mb-3 flex items-center justify-between">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Residency</h3>
        {% if detail.profile.mergedIntoMemberId is null and detail.profile.anonymizedAtIso is null %}
            {# Routed through homeHouseholdId (LRA-210) — see the Profile
               card's Edit button for the rationale. Hidden once the member
               is anonymized (LRA-212): the domain guard refuses the
               mutation anyway. #}
            <button
                type="button"
                data-testid="residency-edit"
                hx-get="{{ path('member_residency_edit_form', { householdId: detail.homeHouseholdId, memberId: detail.profile.memberId }) }}"
                hx-target="#residency-sub-card-body"
                hx-swap="outerHTML"
                class="lr-btn lr-btn-secondary"
            >
                Change Residency
            </button>
        {% endif %}
    </div>

    <div class="flex flex-col gap-2">
        {% include 'components/_badge.html.twig' with {
            label: residency.label(detail.residency.status),
            variant: 'info',
            testid: 'residency-status-badge',
            class: 'w-fit',
        } only %}
        {% if detail.residency.effectiveFromIso is not null %}
            <p data-testid="residency-effective-from" class="text-xs text-litrec-text-muted">
                As of {{ detail.residency.effectiveFromIso|date('M j, Y') }}
            </p>
        {% else %}
            <p data-testid="residency-effective-from-missing" class="text-xs text-litrec-text-muted">
                No residency change recorded yet.
            </p>
        {% endif %}
    </div>
</div>
