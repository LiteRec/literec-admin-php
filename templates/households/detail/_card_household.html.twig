{# Household card (LRA-42).

   Renders the household summary plus a clickable roster of every member
   of the household. Clicking a row issues an HTMX GET against the
   `member_detail_lower_cards` endpoint that replaces the lower three
   cards in-place, while this card stays in the DOM. The card also hosts
   the "Add Member" launcher that opens the LRA-40 dialog targeting the
   current household.

   The wrapping <main> in detail.html.twig owns the collapse-state map
   (`cards.household`); this partial binds the <details> open attribute to
   `cards.household` and writes the URL hash on toggle via `syncHash()`.

   Expects:
     - detail: App\Households\Application\Query\Port\MemberDetail
#}
<div class="lr-card-context">
    <details
        class="group"
        :open="cards.household"
        @toggle="cards.household = $event.target.open; syncHash()"
    >
        <summary
            class="flex cursor-pointer list-none items-center justify-between gap-2 px-5 py-3 text-sm font-semibold uppercase tracking-wide text-litrec-text-muted"
        >
            <span>Household</span>
            <span aria-hidden="true" class="text-xs transition-transform group-open:rotate-180">▾</span>
        </summary>
        <div class="border-t border-litrec-border px-5 py-4">
            <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
                <div class="min-w-0">
                    <h3
                        data-testid="household-card-name"
                        class="text-lg font-bold text-litrec-text"
                    >{{ detail.household.householdName }}</h3>
                    <p class="mt-1 text-xs text-litrec-text-muted">
                        {{ detail.household.memberCount }} member{{ detail.household.memberCount == 1 ? '' : 's' }}
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    {# Link Shared Member (LRA-210): reuses the global member
                       lookup dialog (embedded once by app.html.twig) and, on
                       selection, POSTs directly to household_member_link —
                       unlike the merge flow there is no confirm step. #}
                    <button
                        type="button"
                        data-testid="link-shared-member"
                        aria-haspopup="dialog"
                        class="lr-btn lr-btn-secondary"
                        onclick="window.openMemberLookup({
                            onSelected: function (payload) {
                                var linkUrl = '{{ path('household_member_link', { householdId: detail.household.householdId }) }}';
                                window.htmx.ajax('POST', linkUrl, {
                                    target: '#household-link-error',
                                    swap: 'outerHTML',
                                    values: {
                                        'link_minor_to_household[memberId]': payload.memberId,
                                        'link_minor_to_household[_token]': '{{ csrf_token('link_minor_to_household') }}'
                                    }
                                });
                            }
                        })"
                    >
                        Link Shared Member
                    </button>
                    <button
                        type="button"
                        data-testid="add-member"
                        hx-get="{{ path('households_member_new_form', { householdId: detail.household.householdId }) }}"
                        hx-target="body"
                        hx-swap="beforeend"
                        aria-haspopup="dialog"
                        class="lr-btn lr-btn-primary"
                    >
                        Add Member
                    </button>
                </div>
            </div>

            {# Populated (and swapped in non-empty) by HouseholdLinkController
               on a 422 link/unlink failure; see
               households/detail/_household_link_error.html.twig. Empty on
               initial render. #}
            <div id="household-link-error" data-testid="household-link-error" role="alert" class="sr-only"></div>

            <div class="overflow-x-auto">
                <table class="lr-table">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Code</th>
                            <th scope="col">Status</th>
                        </tr>
                    </thead>
                    {% include 'households/detail/_household_roster_rows.html.twig' with { detail: detail } only %}
                </table>
            </div>
        </div>
    </details>
</div>
