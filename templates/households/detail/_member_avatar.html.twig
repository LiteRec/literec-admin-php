{# Member avatar (LRA-207): renders the uploaded photo when present,
   otherwise the initials-fallback span every call site already rendered
   inline before this ticket.

   Deliberately takes primitive params rather than a single DTO: the three
   call sites (member header, Profile card, Users list row) read from two
   different read-model shapes (MemberProfileDto vs MemberListItem) that
   share no common "profile" type, and the initials text itself differs
   per call site (first+last initial vs a single full-name initial).

   Expects:
     - photoVersion:     string|null  MemberProfileDto/MemberListItem's photoVersion.
     - initials:         string       Pre-computed fallback initials text.
     - photoRouteParams: array        {householdId, memberId, version} for the member_photo route.
     - size:             string       'sm' | 'md' | 'lg'.
     - id:               string|null  Optional element id (e.g. "member-avatar" for the header).
     - oob:              bool         Renders as an hx-swap-oob outerHTML update. Default false.
     - initialsColorClass: string|null  Optional override for the fallback
                           span's background/text-color classes (the Users
                           list row alternates a sage/accent tint per row).
                           Defaults to the sage tint every other call site
                           already used.
#}
{% set oob = oob|default(false) %}
{% set id = id|default(null) %}
{% set initialsColorClass = initialsColorClass|default('bg-litrec-sage-200 text-litrec-sage-800') %}
{% set sizeClasses = {
    sm: 'h-9 w-9 text-xs',
    md: 'h-12 w-12 text-sm',
    lg: 'h-14 w-14 text-lg',
} %}
{% set sizeClass = sizeClasses[size] ?? sizeClasses.md %}

{% if photoVersion is not null %}
    <img
        {% if id is not null %}id="{{ id }}"{% endif %}
        {% if oob %}hx-swap-oob="true"{% endif %}
        src="{{ path('member_photo', photoRouteParams) }}"
        alt=""
        aria-hidden="true"
        data-testid="member-photo-img"
        class="flex-none rounded-full object-cover {{ sizeClass }}"
    >
{% else %}
    <span
        {% if id is not null %}id="{{ id }}"{% endif %}
        {% if oob %}hx-swap-oob="true"{% endif %}
        aria-hidden="true"
        data-testid="member-avatar-initials"
        class="flex flex-none items-center justify-center rounded-full font-bold {{ initialsColorClass }} {{ sizeClass }}"
    >{{ initials }}</span>
{% endif %}
