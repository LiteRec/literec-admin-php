{# Member detail page header (LRA-41), extracted from detail.html.twig so it
   can be re-emitted as an out-of-band swap (LRA-203) when the active member
   changes via the Household card's roster without a full page reload.

   Expects:
     - detail: App\Households\Application\Query\Port\MemberDetail
     - oob: bool  Renders as an hx-swap-oob update (used by the lower-cards
            endpoint to refresh the header for the newly active member).
#}
{% import 'households/_residency.html.twig' as residency %}
{% set oob = oob|default(false) %}
<header
    id="member-header"
    {% if oob %}hx-swap-oob="true"{% endif %}
    data-testid="member-header"
    class="mb-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-b border-litrec-border pb-4"
>
    <div class="flex items-center gap-4">
        {% include 'households/detail/_member_avatar.html.twig' with {
            photoVersion: detail.profile.photoVersion,
            initials: detail.profile.firstName|slice(0, 1) ~ detail.profile.lastName|slice(0, 1),
            photoRouteParams: { householdId: detail.household.householdId, memberId: detail.profile.memberId, version: detail.profile.photoVersion },
            size: 'lg',
            id: 'member-avatar',
        } only %}
        <div>
            <h2 class="font-heading text-2xl font-bold text-litrec-text [font-synthesis-weight:none]">{{ detail.profile.fullName }}</h2>
            <p class="mt-1 text-sm text-litrec-text-muted">{{ detail.household.householdName }}</p>
            {# Linked households (LRA-210): home first, then every household
               this member has been shared with. Only rendered when a share
               actually exists, so members with no links show nothing extra. #}
            {% if detail.linkedHouseholds|length > 1 %}
                <ul data-testid="linked-households" class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-litrec-text-muted">
                    {% for linked in detail.linkedHouseholds %}
                        <li class="flex items-center gap-1" data-testid="linked-household-{{ linked.householdId }}">
                            <a
                                class="{{ linked.isHome ? 'font-semibold text-litrec-text' : 'text-litrec-primary' }} hover:underline"
                                href="{{ path('member_detail', { householdId: linked.householdId, memberId: detail.profile.memberId }) }}"
                            >{{ linked.householdName }}{{ linked.isHome ? ' (Home)' : '' }}</a>
                            {% if not linked.isHome %}
                                <form
                                    method="post"
                                    action="{{ path('household_member_unlink', { householdId: linked.householdId, memberId: detail.profile.memberId }) }}"
                                    hx-post="{{ path('household_member_unlink', { householdId: linked.householdId, memberId: detail.profile.memberId }) }}"
                                    hx-target="#household-link-error"
                                    hx-swap="outerHTML"
                                    hx-confirm="Unlink {{ detail.profile.fullName }} from {{ linked.householdName }}?"
                                >
                                    <input type="hidden" name="withdraw_minor_from_household[_token]" value="{{ csrf_token('withdraw_minor_from_household') }}">
                                    <button
                                        type="submit"
                                        data-testid="unlink-household-{{ linked.householdId }}"
                                        class="lr-btn lr-btn-ghost"
                                    >Unlink</button>
                                </form>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
        {% if detail.profile.mergedIntoMemberId is not null %}
            {% include 'components/_badge.html.twig' with { label: 'Merged', variant: 'neutral', testid: 'badge-merged' } only %}
        {% elseif detail.profile.isActive %}
            {% include 'components/_badge.html.twig' with { label: 'Active', variant: 'success', testid: 'badge-active' } only %}
        {% else %}
            {% include 'components/_badge.html.twig' with { label: 'Deactivated', variant: 'neutral', testid: 'badge-deactivated' } only %}
        {% endif %}
        {% if detail.profile.isPrimary %}
            {% include 'components/_badge.html.twig' with { label: 'Primary', variant: 'info', testid: 'badge-primary' } only %}
        {% else %}
            {% include 'components/_badge.html.twig' with { label: 'Secondary', variant: 'neutral', testid: 'badge-secondary' } only %}
        {% endif %}
        {% include 'components/_badge.html.twig' with {
            label: residency.label(detail.residency.status),
            variant: 'neutral',
            outline: true,
            testid: 'badge-residency',
        } only %}
        {% if detail.profile.mergedIntoMemberId is null and detail.profile.isActive %}
            <button
                type="button"
                data-testid="merge-member"
                class="lr-btn lr-btn-secondary"
                onclick="window.openMemberLookup({
                    onSelected: function (payload) {
                        var confirmUrl = '{{ path('member_merge_confirm_form', { householdId: detail.household.householdId, memberId: detail.profile.memberId }) }}';
                        window.htmx.ajax('GET', confirmUrl + '?duplicateMemberId=' + encodeURIComponent(payload.memberId) + '&duplicateHouseholdId=' + encodeURIComponent(payload.householdId), { target: 'body', swap: 'beforeend' });
                    }
                })"
            >
                Merge duplicate into this member
            </button>
        {% endif %}
    </div>
</header>

{% if detail.profile.mergedIntoMemberId is not null %}
    <div
        data-testid="merged-banner"
        class="mb-6 rounded-card border border-litrec-border bg-litrec-bg-muted p-3 text-sm text-litrec-text"
    >
        This record was merged into
        <a
            class="font-semibold text-litrec-primary hover:underline"
            href="{{ path('member_detail', { householdId: detail.profile.mergedIntoHouseholdId, memberId: detail.profile.mergedIntoMemberId }) }}"
        >this member</a>
        {% if detail.profile.mergedAtIso is not null %}
            on {{ detail.profile.mergedAtIso|date('M j, Y') }}
        {% endif %}.
    </div>
{% endif %}
