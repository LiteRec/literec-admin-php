{# Profile card — read mode (LRA-43).

   Rendered both as the default Profile card body (via _card_profile) and
   as the swap target returned after a successful POST to
   /admin/users/{h}/{m}/profile. The wrapping #card-profile-body element
   in _card_profile.html.twig is restored via `outerHTML` swap so the
   "Edit" button stays inside the swappable region.

   Expects:
     - detail:     App\Households\Application\Query\Port\MemberDetail
     - photoError: string|null  Set by MemberPhotoController on a 422
                   re-render (LRA-207); fills the persistent photo-form
                   error region. Defaults to null.
#}
{% set genderLabelMap = { 'F': 'Female', 'M': 'Male', 'O': 'Other', 'U': 'Unspecified' } %}
{% set genderLabel = genderLabelMap[detail.profile.genderCode] ?? detail.profile.genderCode %}
{% set salutationLabelMap = { 'MR': 'Mr.', 'MRS': 'Mrs.', 'MS': 'Ms.', 'MX': 'Mx.', 'DR': 'Dr.', 'REV': 'Rev.' } %}
{% set salutationLabel = detail.profile.salutationCode is not null ? (salutationLabelMap[detail.profile.salutationCode] ?? detail.profile.salutationCode) : null %}
{% set photoError = photoError|default(null) %}
<div id="card-profile-body" data-testid="card-profile-body" class="border-t border-litrec-border px-5 py-4">
    <div class="mb-4 flex items-center gap-4 border-b border-litrec-border pb-4">
        {% include 'households/detail/_member_avatar.html.twig' with {
            photoVersion: detail.profile.photoVersion,
            initials: detail.profile.firstName|slice(0, 1) ~ detail.profile.lastName|slice(0, 1),
            photoRouteParams: { householdId: detail.household.householdId, memberId: detail.profile.memberId, version: detail.profile.photoVersion },
            size: 'md',
        } only %}
        <div class="flex-1">
            <div
                role="alert"
                data-testid="photo-form-error"
                class="{{ photoError is not null ? 'mb-2 rounded-card bg-danger-bg p-2 text-sm font-semibold text-danger-fg' : 'sr-only' }}"
            >{{ photoError ?? '' }}</div>
            <form
                hx-post="{{ path('member_photo_upload', { householdId: detail.household.householdId, memberId: detail.profile.memberId }) }}"
                hx-target="#card-profile-body"
                hx-swap="outerHTML"
                hx-encoding="multipart/form-data"
                class="flex flex-wrap items-center gap-2"
            >
                <input type="hidden" name="upload_member_photo[_token]" value="{{ csrf_token('upload_member_photo') }}">
                <label class="sr-only" for="profile-photo-input">Photo</label>
                <input
                    id="profile-photo-input"
                    type="file"
                    name="upload_member_photo[photo]"
                    accept="image/jpeg,image/png,image/webp"
                    data-testid="photo-input"
                    class="text-sm text-litrec-text-muted"
                >
                <button type="submit" data-testid="photo-upload" class="lr-btn lr-btn-secondary">
                    Upload photo
                </button>
            </form>
            {% if detail.profile.photoVersion is not null %}
                <form
                    hx-post="{{ path('member_photo_remove', { householdId: detail.household.householdId, memberId: detail.profile.memberId }) }}"
                    hx-target="#card-profile-body"
                    hx-swap="outerHTML"
                    hx-confirm="Remove this member's photo?"
                    class="mt-1"
                >
                    <input type="hidden" name="remove_member_photo[_token]" value="{{ csrf_token('remove_member_photo') }}">
                    <button type="submit" data-testid="photo-remove" class="lr-btn lr-btn-ghost">
                        Remove photo
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    {% if detail.profile.mergedIntoMemberId is null %}
        <div class="mb-3 flex items-center justify-end">
            <button
                type="button"
                data-testid="profile-edit"
                hx-get="{{ path('member_profile_edit_form', { householdId: detail.household.householdId, memberId: detail.profile.memberId }) }}"
                hx-target="#card-profile-body"
                hx-swap="outerHTML"
                class="lr-btn lr-btn-secondary"
            >
                Edit
            </button>
        </div>
    {% endif %}

    <dl class="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Salutation</dt>
            <dd data-testid="profile-salutation" class="mt-1 text-litrec-text">{{ salutationLabel ?? '—' }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">First name</dt>
            <dd data-testid="profile-first-name" class="mt-1 text-litrec-text">{{ detail.profile.firstName }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Middle name</dt>
            <dd data-testid="profile-middle-name" class="mt-1 text-litrec-text">{{ detail.profile.middleName ?? '—' }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Last name</dt>
            <dd data-testid="profile-last-name" class="mt-1 text-litrec-text">{{ detail.profile.lastName }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Suffix</dt>
            <dd data-testid="profile-suffix" class="mt-1 text-litrec-text">{{ detail.profile.suffix ?? '—' }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Goes by</dt>
            <dd data-testid="profile-nickname" class="mt-1 text-litrec-text">{{ detail.profile.nickname ?? '—' }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Date of birth</dt>
            {# dobIso is already a yyyy-MM-dd string from the read model. Echo
               it as-is to avoid UTC date-shift bugs in the browser locale. #}
            <dd data-testid="profile-dob" class="mt-1 text-litrec-text">{{ detail.profile.dobIso ?? '—' }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Gender</dt>
            <dd data-testid="profile-gender" class="mt-1 text-litrec-text">{{ genderLabel }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Height</dt>
            <dd data-testid="profile-height" class="mt-1 text-litrec-text">
                {% if detail.profile.heightInches is not null %}
                    {{ (detail.profile.heightInches // 12) }} ft {{ (detail.profile.heightInches % 12) }} in
                {% else %}
                    —
                {% endif %}
            </dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Weight</dt>
            <dd data-testid="profile-weight" class="mt-1 text-litrec-text">{{ detail.profile.weightPounds is not null ? detail.profile.weightPounds ~ ' lbs' : '—' }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Primary</dt>
            <dd data-testid="profile-primary" class="mt-1 text-litrec-text">{{ detail.profile.isPrimary ? 'Yes' : 'No' }}</dd>
        </div>
        <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Active</dt>
            <dd data-testid="profile-active" class="mt-1 text-litrec-text">{{ detail.profile.isActive ? 'Yes' : 'No' }}</dd>
        </div>
    </dl>
</div>
