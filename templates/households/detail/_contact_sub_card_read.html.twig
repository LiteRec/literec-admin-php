{# Contact sub-card — read mode (LRA-204).

   Renders the member's email and phone. Independent HTMX swap target from
   the Profile card's identity fields so an in-progress Profile edit and an
   in-progress Contact edit never clobber each other. Keeps the
   profile-email / profile-phone testids the E2E spec
   (tests/e2e/users/users.spec.ts) already asserts on.

   Expects:
     - detail: App\Households\Application\Query\Port\MemberDetail
#}
{% set isAnonymized = detail.profile.anonymizedAtIso is not null %}
<div id="contact-sub-card-body" data-testid="contact-sub-card-body" class="rounded-card-sm border border-litrec-border bg-litrec-surface p-4">
    <div class="mb-3 flex items-center justify-between">
        <h3 class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Contact</h3>
        {# Routed through homeHouseholdId (LRA-210) — see the Profile
           card's Edit button for the rationale. Hidden once the member is
           anonymized (LRA-212): there is no contact info left to edit, and
           editing is refused by the domain guard anyway. #}
        {% if not isAnonymized %}
            <button
                type="button"
                data-testid="contact-edit"
                hx-get="{{ path('member_contact_edit_form', { householdId: detail.homeHouseholdId, memberId: detail.profile.memberId }) }}"
                hx-target="#contact-sub-card-body"
                hx-swap="outerHTML"
                class="lr-btn lr-btn-secondary"
            >
                Edit Contact
            </button>
        {% endif %}
    </div>

    {% if isAnonymized %}
        <p class="text-sm text-litrec-text-muted">Contact information was removed when this member was anonymized.</p>
    {% else %}
        <dl class="grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Email</dt>
                <dd data-testid="profile-email" class="mt-1 text-litrec-text">{{ detail.profile.email ?? '—' }}</dd>
            </div>
            <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-litrec-text-muted">Phone</dt>
                <dd data-testid="profile-phone" class="mt-1 text-litrec-text">{{ detail.profile.phone ?? '—' }}</dd>
            </div>
        </dl>
    {% endif %}
</div>
