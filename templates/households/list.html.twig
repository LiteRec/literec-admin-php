{% extends 'app.html.twig' %}

{% block page_title %}Users{% endblock %}

{% block breadcrumbs %}
    {% include 'components/_breadcrumbs.html.twig' with {
        trail: [{ label: 'Dashboard', route: 'app_dashboard' }, { label: 'Users' }],
    } only %}
{% endblock %}

{% block page_actions %}
    {# "Households" reuses the existing primaryOnly criterion: one row per
       household (its primary member) instead of every member — there is no
       separate household-grouped page yet, so this is the household-level
       view of the same list rather than a dead link. #}
    <a
        href="{{ path('users_index', { primaryOnly: 1 }) }}"
        data-testid="view-households"
        class="lr-btn lr-btn-secondary"
    >
        Households
    </a>

    {# LRA-40: opens the Register Household HTMX dialog. The fragment is
       appended to <body> so it overlays the page; closing the modal removes
       its root node and focus returns to this button. #}
    <button
        type="button"
        id="js-new-household"
        data-testid="open-new-household"
        hx-get="{{ path('households_new_form') }}"
        hx-target="body"
        hx-swap="beforeend"
        aria-haspopup="dialog"
        class="lr-btn lr-btn-primary"
    >
        Add user
    </button>
    {% if exportDuplicatesEnabled %}
        <button
            type="button"
            data-testid="export-duplicates"
            class="lr-btn lr-btn-secondary"
        >
            Export Duplicates
        </button>
    {% endif %}
{% endblock %}

{% block page_body %}
    {% include 'households/list/_filters.html.twig' with { counts: counts } %}

    {# Polite live region (LRA-153), mirroring the inventory list pattern:
       refreshed out-of-band by the table partial on every HTMX swap so the
       result count is announced without moving focus. This initial copy
       guarantees the region exists on first paint. #}
    <span
        id="members-result-summary"
        aria-live="polite"
        class="sr-only"
    >Showing {{ page.items|length }} of {{ page.totalItems }} {{ page.totalItems == 1 ? 'user' : 'users' }}</span>

    <div
        id="members-table"
        data-testid="members-table"
        class="mt-6 transition-opacity htmx-request:opacity-50"
        hx-indicator="this"
    >
        {% include 'households/list/_table.html.twig' %}
    </div>
{% endblock %}
