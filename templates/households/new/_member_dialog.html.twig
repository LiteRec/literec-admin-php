{# HTMX fragment: Add Member to Household dialog (LRA-40).

   The household id is encoded in the URL (route parameter `householdId`)
   rather than a hidden form field, so a tampered submission cannot reroute
   the member to a different household.

   Expected variables:
     - form: Symfony FormView built from AddMemberFormType
     - householdId: UUID v7 string of the target household
#}
{% set body %}
    <form
        id="add-member-form"
        method="post"
        action="{{ path('households_member_new_submit', { householdId: householdId }) }}"
        hx-post="{{ path('households_member_new_submit', { householdId: householdId }) }}"
        hx-target="closest .modal-root"
        hx-swap="outerHTML"
        novalidate
    >
        {% include 'components/_form_error_summary.html.twig' with { form: form } only %}

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {{ form_row(form.firstName, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.lastName, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.middleName, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.suffix, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.dobIso, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.genderCode, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.email, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.phone, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.residencyStatusCode, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.memberCode, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
        </div>

        <div class="mt-4">
            {{ form_row(form.isPrimary) }}
        </div>

        {{ form_widget(form._token) }}

        <div class="mt-6 flex items-center justify-end gap-2">
            <button
                type="button"
                class="lr-btn lr-btn-secondary"
                @click="dismiss()"
            >
                Cancel
            </button>
            <button
                type="submit"
                data-testid="add-member-submit"
                class="lr-btn lr-btn-primary"
            >
                Add Member
            </button>
        </div>
    </form>
{% endset %}

{% include 'components/_modal.html.twig' with {
    id: 'add-member-modal',
    title: 'Add Member',
    body: body,
} only %}
