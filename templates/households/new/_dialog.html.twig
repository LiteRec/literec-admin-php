{# HTMX fragment: Register Household dialog (LRA-40).

   Server returns this fragment via either:
     - GET  /admin/users/new            — initial render
     - POST /admin/users/new (422)      — re-render on validation failure

   On success the POST endpoint returns 200 with HX-Redirect: HTMX performs
   a hard navigation to /admin/users/{householdId}/{memberId} so the dialog
   never has to reconcile partial DOM after a write. #}
{% set body %}
    <form
        id="register-household-form"
        method="post"
        action="{{ path('households_new_submit') }}"
        hx-post="{{ path('households_new_submit') }}"
        hx-target="closest .modal-root"
        hx-swap="outerHTML"
        novalidate
    >
        {% include 'components/_form_error_summary.html.twig' with { form: form } only %}

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {{ form_row(form.householdName, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.memberCode, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.firstName, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.lastName, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.middleName, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.suffix, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.dobIso, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.genderCode, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.email, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.phone, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            {{ form_row(form.residencyStatusCode, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
        </div>

        <fieldset class="mt-6 border-t border-litrec-border pt-4">
            <legend class="text-sm font-semibold text-litrec-text">Household address</legend>
            <div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2">
                {{ form_row(form.street, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
                {{ form_row(form.unit, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
                {{ form_row(form.city, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
                {{ form_row(form.state, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
                {{ form_row(form.postalCode, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
                {{ form_row(form.country, { attr: { class: 'litrec-input' }, row_attr: { class: 'lr-field' }, label_attr: { class: 'lr-label' } }) }}
            </div>
        </fieldset>

        {{ form_widget(form._token) }}

        <div class="mt-6 flex items-center justify-end gap-2">
            <button
                type="button"
                class="lr-btn lr-btn-secondary"
                @click="dismiss()"
            >
                Cancel
            </button>
            <button
                type="submit"
                data-testid="register-household-submit"
                class="lr-btn lr-btn-primary"
            >
                Create Household
            </button>
        </div>
    </form>
{% endset %}

{% include 'components/_modal.html.twig' with {
    id: 'register-household-modal',
    title: 'New Household',
    body: body,
} only %}
