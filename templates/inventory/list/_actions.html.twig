{# Action bar for the Inventory list page (LRA-85). Each button is gated
   by the InventoryVoter so unauthorised users do not see actions they
   cannot perform. Real handler endpoints land in later tickets — the
   forms target placeholder URLs but the testids and styling are stable. #}
<div class="flex flex-wrap items-center gap-2">
    {% if is_granted('manage_inventory') %}
        <button
            type="button"
            data-testid="open-new-inventory-item"
            hx-get="{{ path('inventory_item_new') }}"
            hx-target="body"
            hx-swap="beforeend"
            aria-haspopup="dialog"
            class="lr-btn lr-btn-primary"
        >
            New Item
        </button>

        <button
            type="button"
            data-testid="open-new-inventory-group"
            hx-get="{{ path('inventory_group_new') }}"
            hx-target="body"
            hx-swap="beforeend"
            aria-haspopup="dialog"
            class="lr-btn lr-btn-secondary"
        >
            New Group
        </button>

        <button
            type="button"
            data-testid="open-new-inventory-combo"
            hx-get="{{ path('inventory_combo_new') }}"
            hx-target="body"
            hx-swap="beforeend"
            aria-haspopup="dialog"
            class="lr-btn lr-btn-secondary"
        >
            New Combo
        </button>

    {% endif %}

    {% if is_granted('take_inventory') %}
        <a
            href="{{ path('inventory_take_index') }}"
            data-testid="goto-take-inventory"
            class="lr-btn lr-btn-secondary"
        >
            Take Inventory
        </a>
    {% endif %}

    {% if is_granted('manage_purchase_orders') %}
        <a
            href="{{ path('po_index') }}"
            data-testid="goto-purchase-orders"
            class="lr-btn lr-btn-secondary"
        >
            Purchase Orders
        </a>
    {% endif %}

    {% if is_granted('view_inventory') %}
        <a
            href="{{ path('inventory_reports_index') }}"
            data-testid="goto-inventory-reports"
            class="lr-btn lr-btn-secondary"
        >
            Reports
        </a>
    {% endif %}
</div>
