{# Current Stock body partial — HTMX swap target for the card form.
   Expects:
     - currentStock: CurrentStockReportPage #}
{% if currentStock.totalCount == 0 %}
    {% include 'components/_empty_state.html.twig' with {
        title: 'No items',
        message: 'No inventory items match the current filters.',
    } only %}
{% else %}
    <div class="overflow-x-auto">
        <table class="lr-table" data-testid="report-current-stock-table">
            <thead>
                <tr>
                    <th scope="col">Code</th>
                    <th scope="col">Name</th>
                    <th scope="col">Facility</th>
                    <th scope="col" class="text-right">On hand</th>
                    <th scope="col" class="text-right">Threshold</th>
                </tr>
            </thead>
            <tbody>
                {% for row in currentStock.items %}
                    {% set lowStockTextClass = row.isAtOrBelowThreshold ? 'text-danger-fg' : '' %}
                    <tr
                        data-testid="report-current-stock-row-{{ row.inventoryItemId }}"
                        class="{% if row.isAtOrBelowThreshold %}bg-danger-bg{% endif %}"
                    >
                        <td class="font-mono text-xs {{ lowStockTextClass ?: 'text-litrec-text' }}">{{ row.listingCode }}</td>
                        <td class="{{ lowStockTextClass ?: 'text-litrec-text' }}">{{ row.name }}</td>
                        <td class="{{ lowStockTextClass ?: 'text-litrec-text-muted' }}">{{ row.facilityCode }}</td>
                        <td class="text-right font-mono {{ lowStockTextClass ?: 'text-litrec-text' }}">
                            {{ row.onHandUnits }}
                            {% if row.isAtOrBelowThreshold %}
                                {# Non-color marker (LRA-155, WCAG 1.4.1): the red row tint
                                   alone must not be the only signal that stock is low. #}
                                {% include 'components/_badge.html.twig' with { label: 'Low', variant: 'danger' } only %}
                            {% endif %}
                        </td>
                        <td class="text-right font-mono {{ lowStockTextClass ?: 'text-litrec-text-muted' }}">
                            {% if row.reorderThresholdUnits > 0 %}{{ row.reorderThresholdUnits }}{% else %}—{% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="mt-2 text-xs text-litrec-text-muted" data-testid="report-current-stock-count">
        {{ currentStock.totalCount }} row{{ currentStock.totalCount == 1 ? '' : 's' }}
    </p>
{% endif %}
