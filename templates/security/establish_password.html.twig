{% extends 'base.html.twig' %}

{% import 'components/_icon.html.twig' as icon %}

{% block title %}Set a new password — LiteRecAdmin{% endblock %}

{% block body %}
    <main id="main-content" tabindex="-1" class="flex min-h-screen items-center justify-center bg-litrec-bg p-6">
        <div
            data-gsap="card"
            class="w-full max-w-md rounded-modal border border-litrec-border bg-litrec-surface p-8 shadow-pop"
            x-data="{ submitting: false }"
        >
            <div class="flex flex-col items-center text-center">
                <span class="lr-brand-mark mb-3 h-11 w-11">{{ icon.icon('key', 22) }}</span>
                <h1 class="font-heading text-2xl font-bold text-litrec-primary [font-synthesis-weight:none]">Set a new password</h1>
                <p class="mt-1 text-sm text-litrec-text-muted">
                    You signed in with a one-time password. Choose a new password to continue.
                </p>
            </div>

            {% for label, messages in app.flashes(['success', 'error']) %}
                {% for message in messages %}
                    <p role="alert" class="mt-4 text-sm font-semibold {{ label == 'success' ? 'text-success' : 'text-danger' }}">
                        {{ message }}
                    </p>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, { attr: { class: 'mt-6 space-y-4', novalidate: 'novalidate' } }) }}
                {% include 'components/_form_error_summary.html.twig' with { form: form, testid: 'establish-password-form-error' } only %}

                {{ form_row(form.newPassword, {
                    row_attr: { class: 'lr-field' },
                    label_attr: { class: 'lr-label' },
                    attr: { class: 'litrec-input', autocomplete: 'new-password' },
                }) }}

                <button
                    type="submit"
                    data-testid="establish-password-submit"
                    class="lr-btn lr-btn-primary lr-btn-lg lr-btn-block disabled:cursor-not-allowed disabled:opacity-60"
                    :disabled="submitting"
                    x-on:click="submitting = true"
                    x-text="submitting ? 'Saving…' : 'Set password'"
                >Set password</button>
            {{ form_end(form) }}
        </div>
    </main>
{% endblock %}
