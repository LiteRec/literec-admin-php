{% extends 'app.html.twig' %}

{% import 'components/_icon.html.twig' as ui %}

{% block page_title %}{{ dashboard.greeting }}{% endblock %}

{% block page_subtitle %}{{ dashboard.today|date('l, F j, Y') }} · {{ selected_facility() }}{% endblock %}

{% block page_actions %}
    <a href="{{ path('reports_index') }}" class="lr-btn lr-btn-secondary">{{ ui.icon('printer', 15) }} Close-out report</a>
    <a href="{{ path('cash_register_index') }}" class="lr-btn lr-btn-primary">{{ ui.icon('cart', 15) }} New sale</a>
{% endblock %}

{% block page_body %}
    {# KPI tiles — flat cards rendered through the reusable _kpi_card component. #}
    <section aria-labelledby="kpi-heading" class="mb-6">
        <h2 id="kpi-heading" class="sr-only">Key performance indicators</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {% for kpi in dashboard.kpis %}
                {% include 'components/_kpi_card.html.twig' with {
                    icon: kpi.icon,
                    value: kpi.value,
                    label: kpi.label,
                    tint: kpi.tint.value,
                    deltaText: kpi.deltaText,
                    deltaTone: kpi.deltaTone ? kpi.deltaTone.value : null,
                    note: kpi.note,
                } only %}
            {% endfor %}
        </div>
    </section>

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
        {# Recent transactions — real transaction feed with an HTMX status filter. #}
        <section aria-labelledby="transactions-heading" data-gsap="card" class="lr-card lg:col-span-2">
            <div class="lr-card-head">
                <span class="lr-card-title inline-flex items-center gap-2">
                    {{ ui.icon('bolt', 16, 2.75, 'text-litrec-secondary') }}
                    <span id="transactions-heading">Recent transactions</span>
                </span>
                <a href="{{ path('reports_index') }}" class="lr-link text-xs font-semibold">All POS transactions</a>
            </div>
            <div class="lr-card-body">
                <div id="dashboard-transactions-table">
                    {% include 'dashboard/_transactions_table.html.twig' with {
                        transactions: transactions,
                        status: status,
                        statusCases: statusCases,
                    } only %}
                </div>
            </div>
        </section>

        <div class="flex flex-col gap-5">
            {# Upcoming — presentation-only sample data (Scheduling context pending). #}
            <section aria-labelledby="upcoming-heading" data-gsap="card" class="lr-card-context">
                <div class="lr-card-head">
                    <span class="lr-card-title inline-flex items-center gap-2">
                        {{ ui.icon('calendar', 16, 2.75, 'text-litrec-secondary') }}
                        <span id="upcoming-heading">Upcoming</span>
                    </span>
                    <a href="{{ path('facilities_index') }}" class="lr-link text-xs font-semibold">Calendar</a>
                </div>
                <div class="lr-list">
                    {% for event in dashboard.upcomingEvents %}
                        <div class="lr-list-row" data-testid="event-row">
                            <span class="lr-datebadge"><span class="d lr-num">{{ event.day }}</span><span class="m">{{ event.month }}</span></span>
                            <div class="min-w-0 flex-1">
                                <div class="lr-row-strong truncate text-sm">{{ event.title }}</div>
                                <div class="lr-muted inline-flex items-center gap-1 text-xs">{{ ui.icon('pin', 11) }} {{ event.location }}</div>
                            </div>
                            {% include 'components/_badge.html.twig' with { label: event.enrolledCount ~ ' enrolled', variant: 'success' } only %}
                        </div>
                    {% endfor %}
                </div>
            </section>

            {# Facilities today — presentation-only sample data (Facilities read model pending). #}
            <section aria-labelledby="facilities-heading" data-gsap="card" class="lr-card-context">
                <div class="lr-card-head">
                    <span class="lr-card-title inline-flex items-center gap-2">
                        {{ ui.icon('tree', 16, 2.75, 'text-litrec-secondary') }}
                        <span id="facilities-heading">Facilities today</span>
                    </span>
                    <a href="{{ path('facilities_index') }}" class="lr-link text-xs font-semibold">All facilities</a>
                </div>
                {% set dot_colors = {
                    'success': 'var(--lr-success)',
                    'warning': 'var(--lr-warning)',
                    'neutral': 'var(--lr-text-muted)',
                } %}
                <div class="lr-list">
                    {% for facility in dashboard.facilityStatuses %}
                        <div class="lr-list-row" data-testid="facility-row">
                            {# Dot is decorative; the badge text below is the accessible status signal (WCAG 1.4.1). #}
                            <span class="lr-dot h-2.5 w-2.5" aria-hidden="true" style="background: {{ dot_colors[facility.badgeVariant] ?? 'var(--lr-text-muted)' }}"></span>
                            <div class="min-w-0 flex-1">
                                <div class="lr-row-strong truncate text-sm">{{ facility.name }}</div>
                                <div class="lr-muted text-xs"><span class="lr-num">{{ facility.checkInsToday }}</span> check-ins</div>
                            </div>
                            {% include 'components/_badge.html.twig' with { label: facility.conditionLabel, variant: facility.badgeVariant, class: 'uppercase' } only %}
                        </div>
                    {% endfor %}
                </div>
            </section>
        </div>
    </div>
{% endblock %}
