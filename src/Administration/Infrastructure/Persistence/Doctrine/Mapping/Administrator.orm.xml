<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        Administrator aggregate root. Identity is generated by the
        aggregate (AdministratorId, UUID v7) via the IdentityGenerator
        port — no GeneratedValue strategy here.

        sign_in_account_id is unique-constrained (a sign-in account holds
        at most one administrator record ever) but carries no foreign
        key to the Users context's `user` table: App\Users and
        App\Administration are separate bounded contexts, and the
        project forbids foreign keys across a context boundary.

        rank_id carries no foreign key either, for a narrower reason:
        Rank is a separate aggregate within this same context, and the
        project forbids Doctrine associations (and, by the same
        precedent DoctrineRanks/Rank.orm.xml sets for role_id on
        administration_rank_roles, foreign keys) across an aggregate
        boundary. GrantAdministrator's handler (LRA-279) is what stops
        an orphaned or retired-rank grant, not this schema.

        Tenures and directly assigned roles are bidirectional one-to-many
        with the inverse side (mapped-by) owning the administrator_id FK
        column on each child table. orphan-removal + cascade={persist,
        remove} keeps both child tables strictly owned by this aggregate
        — unlike Rank's role grants, these are ordinary Doctrine
        associations because both child tables belong to this aggregate,
        not to a relationship between two aggregates.
    -->
    <entity name="App\Administration\Domain\Administrator" table="administration_administrators">

        <unique-constraints>
            <unique-constraint name="UNIQ_administration_administrators_sign_in_account" columns="sign_in_account_id"/>
        </unique-constraints>

        <id name="id" type="administration_administrator_id"/>

        <field name="signInAccountId" column="sign_in_account_id" type="administration_sign_in_account_id" nullable="false"/>
        <field name="rankId"          column="rank_id"            type="administration_rank_id"            nullable="false"/>
        <field name="standing"        column="standing"           type="string" length="20" nullable="false" enum-type="App\Administration\Domain\ValueObject\AdministratorStanding"/>
        <!--
            Touched by every mutator (see Administrator::$updatedAt's
            docblock) purely to keep the optimistic-lock version check
            live for collection-only mutations such as
            assignRole()/unassignRole() — Doctrine only checks/increments
            $version when it emits an UPDATE for this row, which it does
            not do for a root whose only change is a child collection.
        -->
        <field name="updatedAt"       column="updated_at"         type="datetime_immutable"                nullable="false"/>
        <field name="version"         column="version"            type="integer" version="true" nullable="false">
            <options>
                <option name="default">0</option>
            </options>
        </field>

        <one-to-many field="tenures" target-entity="App\Administration\Domain\AdministratorTenure" mapped-by="administrator" orphan-removal="true" fetch="EAGER">
            <!--
                Without an explicit order, Doctrine hydrates this
                collection in whatever order Postgres happens to return
                rows, which is not guaranteed to be insertion order.
                tenures() callers (including this codebase's own
                contract tests) read history chronologically, so order
                by grantedAt with id as a stable tie-breaker for tenures
                granted in the same instant.
            -->
            <order-by>
                <order-by-field name="grantedAt" direction="ASC"/>
                <order-by-field name="id" direction="ASC"/>
            </order-by>
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <one-to-many field="roleAssignments" target-entity="App\Administration\Domain\AdministratorRoleAssignment" mapped-by="administrator" orphan-removal="true" fetch="EAGER">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

    </entity>

</doctrine-mapping>
