<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        AdministratorTenure child entity, owned by Administrator. Own id
        column (AdministratorTenureId, UUID v7, generated by the
        aggregate). grantedBy is always populated; revokedAt/revokedBy/
        revocationReason are all null while the tenure is open and all
        populated once closed — see AdministratorTenure::close() and the
        migration's CHECK constraints, which enforce that pairing at the
        database level.

        The postLoad callback exists because Doctrine ORM 3.7 does not
        leave the revokedBy property null when every one of its embedded
        columns is NULL — it constructs an Actor with every field null
        instead (confirmed against a live reload). See
        AdministratorTenure::normalizeAfterLoad() and Actor's own
        docblock.

        "At most one open tenure per administrator" — the invariant
        Administrator::standing() and currentTenure() both rest on — is
        enforced by a partial unique index (UNIQ_administration_tenures_open
        ON administration_tenures (administrator_id) WHERE revoked_at IS
        NULL) created by raw SQL in the migration: Doctrine's XML mapping
        has no first-class partial-unique-index type, the same reason the
        functional LOWER(name) indexes on administration_roles/
        administration_ranks are raw SQL. Not expressed here, and must
        not be dropped by a future schema diff.
    -->
    <entity name="App\Administration\Domain\AdministratorTenure" table="administration_tenures">

        <indexes>
            <index name="IDX_administration_tenures_administrator" columns="administrator_id"/>
        </indexes>

        <id name="id" type="administration_administrator_tenure_id"/>

        <field name="grantedAt"        column="granted_at"        type="datetime_immutable"                nullable="false"/>
        <field name="revokedAt"        column="revoked_at"        type="datetime_immutable"                nullable="true"/>
        <field name="revocationReason" column="revocation_reason" type="administration_revocation_reason"  nullable="true"/>

        <embedded name="grantedBy" class="App\Administration\Domain\ValueObject\Actor" column-prefix="granted_by_"/>
        <embedded name="revokedBy" class="App\Administration\Domain\ValueObject\Actor" column-prefix="revoked_by_"/>

        <many-to-one field="administrator" target-entity="App\Administration\Domain\Administrator" inversed-by="tenures" fetch="LAZY">
            <join-column name="administrator_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <lifecycle-callbacks>
            <lifecycle-callback type="postLoad" method="normalizeAfterLoad"/>
        </lifecycle-callbacks>

    </entity>

</doctrine-mapping>
