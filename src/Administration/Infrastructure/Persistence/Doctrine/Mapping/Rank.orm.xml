<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <!--
        Rank aggregate root. Identity is generated by the aggregate
        (RankId, UUID v7) via the IdentityGenerator port — no
        GeneratedValue strategy here.

        No assigned-roles field is mapped here: that set lives in the
        administration_rank_roles join table, reconciled directly by
        DoctrineRanks with DBAL statements rather than through a Doctrine
        association — RoleId identifies an aggregate this one does not
        own, and CLAUDE.md forbids associations across aggregate
        boundaries. Rank still holds an in-memory AssignedRoles value
        object; see Rank's own docblock.
    -->
    <entity name="App\Administration\Domain\Rank" table="administration_ranks">

        <!--
            No <unique-constraints> block here, same treatment as
            Role.orm.xml: the uniqueness invariant is a functional UNIQUE
            INDEX on LOWER(name), created by raw SQL in the migration, not
            a plain column constraint — RankName::equals() is
            case-insensitive, so the write-time predicate must be too.
            Declaring a byte-exact <unique-constraint columns="name"/>
            here would both under-enforce the invariant and make
            doctrine:schema:validate diff against the functional index the
            migration actually creates.
        -->

        <indexes>
            <index name="IDX_administration_ranks_seniority" columns="seniority"/>
        </indexes>

        <id name="id" type="administration_rank_id"/>

        <field name="name"      column="name"        type="administration_rank_name"       nullable="false"/>
        <field name="seniority" column="seniority"   type="administration_seniority_level"  nullable="false"/>
        <field name="retired"   column="retired"     type="boolean"                         nullable="false">
            <options>
                <option name="default">false</option>
            </options>
        </field>
        <field name="definedAt" column="defined_at"  type="datetime_immutable"              nullable="false"/>
        <field name="updatedAt" column="updated_at"  type="datetime_immutable"              nullable="false"/>
        <field name="version"   column="version"     type="integer" version="true"          nullable="false">
            <options>
                <option name="default">0</option>
            </options>
        </field>

    </entity>

</doctrine-mapping>
