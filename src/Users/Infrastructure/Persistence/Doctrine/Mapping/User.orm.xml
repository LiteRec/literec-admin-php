<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Users\Domain\User" table="`user`">

        <unique-constraints>
            <unique-constraint name="UNIQ_IDENTIFIER_USERNAME" columns="username"/>
        </unique-constraints>

        <!--
            Identity is generated by the aggregate (UserId, UUID v7) via the
            IdentityGenerator port — no GeneratedValue strategy here.
            Stored as a 36-char string column via the users_user_id custom type.
        -->
        <id name="id" type="users_user_id"/>

        <field name="username" type="users_username" nullable="false"/>
        <field name="roles"    type="users_roles"   nullable="false"/>
        <field name="password" type="users_hashed_password" nullable="false"/>
        <!-- LRA-213: one-time-password lifecycle state, defaulted to
             'established' so every pre-existing row remains valid. -->
        <field name="passwordState" type="string" length="32" column="password_state"
               nullable="false" enum-type="App\Users\Domain\ValueObject\PasswordState">
            <options>
                <option name="default">established</option>
            </options>
        </field>
        <!-- LRA-213: when the currently-issued one-time password was
             issued, so UserChecker can reject one past its TTL. Null for
             Established accounts. -->
        <field name="oneTimePasswordIssuedAt" type="datetime_immutable"
               column="one_time_password_issued_at" nullable="true"/>
        <field name="isActive" type="boolean" nullable="false">
            <options>
                <option name="default">true</option>
            </options>
        </field>
        <field name="createdAt" type="datetime_immutable" nullable="false"/>
        <!-- LRA-213: optimistic lock so two concurrent logins racing to
             consume the same one-time password cannot both succeed —
             DoctrineUsers::save() translates the resulting
             OptimisticLockException into ConcurrentUserModification. -->
        <field name="version" type="integer" version="true" nullable="false">
            <options>
                <option name="default">0</option>
            </options>
        </field>

        <lifecycle-callbacks>
            <lifecycle-callback type="prePersist" method="assertPasswordIsSet"/>
            <lifecycle-callback type="preUpdate"  method="assertPasswordIsSet"/>
        </lifecycle-callbacks>

    </entity>

</doctrine-mapping>
